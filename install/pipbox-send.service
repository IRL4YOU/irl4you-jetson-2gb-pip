[Unit]
Description=IRL4YOU BOX Sendekette (srtla_send und belacoder)
After=network-online.target

[Service]
Environment=LC_ALL=C.UTF-8 LANG=C.UTF-8
Type=simple
ExecStart=/usr/bin/python3 -u /opt/pipbox/pipbox_send.py
SuccessExitStatus=1
Restart=no
TimeoutStopSec=20
RuntimeDirectory=pipbox-send
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
