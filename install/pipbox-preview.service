[Unit]
Description=Jetson 2GB PIP Vorschau des gesendeten Bildes (liest den lokalen SRT-Strom mit, startet bei Bedarf, endet nach einer Minute ohne Zuschauer)
Requires=pipbox-preview.socket
After=pipbox-preview.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/pipbox/pipbox_preview.py --serve
# (Kein PrivateTmp: der Dienst liest die Pipeline-Datei in /var/tmp/pipbox, um den Codec zu erkennen.)
# Läuft als root, weil die Video-Hardware (Decoder und Encoder, /dev/nvhost-*, /dev/nvmap) nur root öffnen darf; der Webserver hat dieses Recht nicht.
Environment=LC_ALL=C.UTF-8
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_PACKET
RestrictNamespaces=yes
LockPersonality=yes
# GStreamer legt sein Zwischenverzeichnis hier ab (sonst bei jedem Start neu aufgebaut)
CacheDirectory=pipbox-preview
Environment=GST_REGISTRY=/var/cache/pipbox-preview/gst-registry.bin
Environment=XDG_CACHE_HOME=/var/cache/pipbox-preview
